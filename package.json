{
  "name": "simple-meeting-sidebar",
  "version": "0.5.3",
  "private": true,
  "description": "A macOS-only sidebar for today's Apple Calendar meetings.",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build:plugin": "tsc --noEmit && node esbuild.config.mjs production",
    "build:helper": "bash scripts/build-helper.sh",
    "package:release": "bash scripts/package-release.sh",
    "build": "npm run build:plugin && npm run package:release",
    "test:ts": "node --import tsx --test tests/*.test.ts",
    "test:swift": "runtime/calendar-helper --self-test",
    "test": "npm run test:ts && npm run test:swift",
    "lint": "eslint .",
    "check": "npm run lint && npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.9.1",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.12.0",
    "obsidian": "^1.8.7",
    "tslib": "^2.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
